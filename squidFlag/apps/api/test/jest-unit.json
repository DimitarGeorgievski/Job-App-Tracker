{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".*\\.spec\\.ts$",
  "testPathIgnorePatterns": [
    "/node_modules/",
    "\\.int-spec\\.ts$",
    "\\.e2e-spec\\.ts$"
  ],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": ["node_modules/(?!(.pnpm/)?@nestjs)"],
  "moduleNameMapper": {
    "^generated/(.*)$": "<rootDir>/../generated/$1",
    "^src/(.*)$": "<rootDir>/../src/$1"
  }
}
