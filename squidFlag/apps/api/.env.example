NODE_ENV=development
APP_ROLE=all
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=debug
DATABASE_URL=postgresql://postgres:local-development-password@127.0.0.1:5433/squidflag?schema=public
CORS_ORIGINS=http://localhost:4001
REDIS_URL=redis://:your-local-redis-password@127.0.0.1:6380
# Cloudflare R2 
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=squidflag
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key